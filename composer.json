{
    "name": "odc/reservation-salles",
    "description": "Application de gestion des réservations de salles universitaires",
    "type": "project",
    "require": {
        "php": "^8.2",
        "nikic/fast-route": "^2.0",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}